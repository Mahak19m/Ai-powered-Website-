# =====================================================================
# WebCraft AI - Environment Configuration Example
# Copy this file to .env and configure the values for your environment.
# =====================================================================

# ---------------------------------------------------------------------
# AI Provider Configuration (Google Gemini)
# Optional: If omitted, WebCraft AI runs using its built-in templates.
# Get a free key at: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------
# Database Configuration
# Defaults to local SQLite. For production, switch to PostgreSQL.
# SQLite example: sqlite:///./webcraft.db
# PostgreSQL example: postgresql://username:password@localhost:5432/webcraft
# ---------------------------------------------------------------------
DATABASE_URL=sqlite:///./webcraft.db

# ---------------------------------------------------------------------
# Backend Server Configuration
# ---------------------------------------------------------------------
PORT=8000

# ---------------------------------------------------------------------
# Frontend Configuration (Optional)
# In local development, Vite proxies /api to http://127.0.0.1:8000.
# For decoupled production deployments, set your backend API URL here:
# VITE_API_BASE_URL=https://api.yourdomain.com/api
# ---------------------------------------------------------------------
VITE_API_BASE_URL=/api
