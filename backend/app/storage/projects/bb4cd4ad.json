to-indigo-300\">an AI productivity</span>\n      </a>\n\n      <!-- Desktop Nav Links -->\n      <nav class=\"hidden md:flex items-center gap-8 text-sm font-medium\">\n        <a href=\"index.html\" class=\"text-indigo-400 font-semibold transition-colors\">Pricing</a>\n        <a href=\"contact.html\" class=\"text-slate-400 hover:text-white transition-colors\">Contact</a>\n        <a href=\"use-a-consistent-modern-dark-theme-across-all.html\" class=\"text-slate-400 hover:text-white transition-colors\">Use A Consistent Modern Dark Theme Across All</a>\n      </nav>\n\n      <div class=\"hidden md:flex items-center gap-4\">\n        <a href=\"use-a-consistent-modern-dark-theme-across-all.html\" class=\"px-5 py-2.5 rounded-xl text-sm font-semibold bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white shadow-md shadow-indigo-500/20 transition-all flex items-center gap-2\">\n          <span>Get Started</span>\n          <i data-lucide=\"arrow-right\" class=\"w-4 h-4\"></i>\n        </a>\n      </div>\n\n      <!-- Mobile Hamburger Button -->\n      <button id=\"mobile-menu-btn\" class=\"md:hidden p-2 text-slate-400 hover:text-white rounded-lg border border-slate-800\">\n        <i data-lucide=\"menu\" class=\"w-5 h-5\"></i>\n      </button>\n    </div>\n\n    <!-- Mobile Drawer -->\n    <div id=\"mobile-menu\" class=\"hidden md:hidden px-6 py-4 bg-slate-900 border-b border-slate-800 space-y-2 text-sm\">\n      <a href=\"index.html\" class=\"block py-1.5 text-indigo-400 font-semibold\">Pricing</a>\n      <a href=\"contact.html\" class=\"block py-1.5 text-slate-300 hover:text-white\">Contact</a>\n      <a href=\"use-a-consistent-modern-dark-theme-across-all.html\" class=\"block py-1.5 text-slate-300 hover:text-white\">Use A Consistent Modern Dark Theme Across All</a>\n      <div class=\"pt-2\">\n        <a href=\"use-a-consistent-modern-dark-theme-across-all.html\" class=\"block text-center py-2 px-4 rounded-lg bg-indigo-600 text-white font-semibold text-xs\">Get Started</a>\n      </div>\n    </div>\n  </header>\n\n  <!-- Pricing Page -->\n  <section class=\"py-24\">\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center\">\n      <div class=\"max-w-2xl mx-auto mb-16\">\n        <h2 class=\"text-xs font-bold text-indigo-400 uppercase tracking-widest mb-3\">Transparent Plans</h2>\n        <h1 class=\"text-4xl sm:text-5xl font-extrabold text-white tracking-tight\">Predictable Pricing for High-Growth Teams</h1>\n        <p class=\"text-slate-400 text-lg mt-4 leading-relaxed\">\n          Start in our free sandbox and scale up seamlessly as your team's workflow requirements expand.\n        </p>\n      </div>\n\n      <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-8 max-w-5xl mx-auto text-left mb-20\">\n        <!-- Starter Plan -->\n        <div class=\"p-8 rounded-2xl bg-slate-900 border border-slate-800 flex flex-col justify-between\">\n          <div>\n            <h4 class=\"text-lg font-bold text-white mb-2\">Starter</h4>\n            <p class=\"text-slate-400 text-sm mb-6\">For individuals and prototyping.</p>\n            <div class=\"text-4xl font-extrabold text-white mb-6\">$0<span class=\"text-sm font-normal text-slate-500\"> / month</span></div>\n            <ul class=\"space-y-3 text-sm text-slate-300 mb-8\">\n              <li class=\"flex items-center gap-2\"><i data-lucide=\"check\" class=\"w-4 h-4 text-indigo-400\"></i> Up to 3 autonomous agents</li>\n              <li class=\"flex items-center gap-2\"><i data-lucide=\"check\" class=\"w-4 h-4 text-indigo-400\"></i> 10,000 monthly execution tokens</li>\n              <li class=\"flex items-center gap-2\"><i data-lucide=\"check\" class=\"w-4 h-4 text-indigo-400\"></i> Standard integrations (Slack, Notion)</li>\n              <li class=\"flex items-center gap-2\"><i data-lucide=\"check\" class=\"w-4 h-4 text-indigo-400\"></i> Community support</li>\n            </ul>\n          </div>\n          <button class=\"w-full py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-semibold transition\">Get Started Free</button>\n        </div>\n\n        <!-- Pro Plan -->\n        <div class=\"p-8 rounded-2xl bg-slate-900 border-2 border-indigo-500 shadow-2xl shadow-indigo-500/15 flex flex-col justify-between relative\">\n          <div class=\"absolute -top-3.5 left-1/2 -translate-x-1/2 px-3 py-1 rounded-full bg-indigo-600 text-[10px] font-bold tracking-wider text-white uppercase\">Most Popular</div>\n          <div>\n            <h4 class=\"text-lg font-bold text-white mb-2\">Team Pro</h4>\n            <p class=\"text-slate-400 text-sm mb-6\">For fast-moving engineering &amp; product teams.</p>\n            <div class=\"text-4xl font-extrabold text-white mb-6\">$49<span class=\"text-sm font-normal text-slate-500\"> / month</span></div>\n            <ul class=\"space-y-3 text-sm text-slate-300 mb-8\">\n              <li class=\"flex items-center gap-2\"><i data-lucide=\"check\" class=\"w-4 h-4 text-indigo-400\"></i> Unlimited autonomous agent swarms</li>\n              <li class=\"flex items-center gap-2\"><i data-lucide=\"check\" class=\"w-4 h-4 text-indigo-400\"></i> 1,000,000 monthly execution tokens</li>\n              <li class=\"flex items-center gap-2\"><i data-lucide=\"check\" class=\"w-4 h-4 text-indigo-400\"></i> Advanced integrations (GitHub, Jira, Linear)</li>\n              <li class=\"flex items-center gap-2\"><i data-lucide=\"check\" class=\"w-4 h-4 text-indigo-400\"></i> Real-time priority agent execution</li>\n              <li class=\"flex items-center gap-2\"><i data-lucide=\"check\" class=\"w-4 h-4 text-indigo-400\"></i> Priority 24/7 technical support</li>\n            </ul>\n          </div>\n          <button class=\"w-full py-3 rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white font-semibold transition shadow-lg shadow-indigo-600/30\">Start 14-Day Free Trial</button>\n        </div>\n\n        <!-- Enterprise Plan -->\n        <div class=\"p-8 rounded-2xl bg-slate-900 border border-slate-800 flex flex-col justify-between\">\n          <div>\n            <h4 class=\"text-lg font-bold text-white mb-2\">Enterprise</h4>\n            <p class=\"text-slate-400 text-sm mb-6\">Dedicated deployment &amp; bespoke governance.</p>\n            <div class=\"text-4xl font-extrabold text-white mb-6\">Custom</div>\n            <ul class=\"space-y-3 text-sm text-slate-300 mb-8\">\n              <li class=\"flex items-center gap-2\"><i data-lucide=\"check\" class=\"w-4 h-4 text-indigo-400\"></i> Dedicated isolated VPC deployment</li>\n              <li class=\"flex items-center gap-2\"><i data-lucide=\"check\" class=\"w-4 h-4 text-indigo-400\"></i> Custom fine-tuned domain models</li>\n              <li class=\"flex items-center gap-2\"><i data-lucide=\"check\" class=\"w-4 h-4 text-indigo-400\"></i> SAML SSO, SCIM &amp; custom audit exports</li>\n              <li class=\"flex items-center gap-2\"><i data-lucide=\"check\" class=\"w-4 h-4 text-indigo-400\"></i> Dedicated customer success manager &amp; SLA</li>\n            </ul>\n          </div>\n          <button class=\"w-full py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-semibold transition\">Contact Enterprise Sales</button>\n        </div>\n      </div>\n\n      <!-- FAQ Section -->\n      <div id=\"pricing-faq\" class=\"max-w-3xl mx-auto text-left pt-12 border-t border-slate-900\">\n        <h3 class=\"text-2xl font-bold text-white text-center mb-8\">Frequently Asked Questions</h3>\n        <div class=\"space-y-4\">\n          <div class=\"p-6 rounded-2xl bg-slate-900/60 border border-slate-800\">\n            <h5 class=\"text-base font-bold text-white mb-2\">Can I switch plans or cancel anytime?</h5>\n            <p class=\"text-sm text-slate-400\">Yes! You can upgrade, downgrade, or cancel your subscription at any time directly from the settings console with zero penalties.</p>\n          </div>\n          <div class=\"p-6 rounded-2xl bg-slate-900/60 border border-slate-800\">\n            <h5 class=\"text-base font-bold text-white mb-2\">How do execution tokens work?</h5>\n            <p class=\"text-sm text-slate-400\">Tokens correspond to the computational steps executed by your autonomous agent swarms. Starter includes 10k tokens/mo, while Pro includes 1M tokens.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Footer -->\n  <footer class=\"border-t border-slate-900 bg-slate-950 py-12 text-center text-xs text-slate-500\">\n    <div class=\"max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-6\">\n      <div class=\"flex items-center gap-3 font-semibold text-slate-300\">\n        <div class=\"w-7 h-7 rounded-lg bg-indigo-600 flex items-center justify-center text-white\">\n          <i data-lucide=\"sparkles\" class=\"w-3.5 h-3.5\"></i>\n        </div>\n        <span>an AI productivity Platform</span>\n      </div>\n      <div class=\"flex flex-wrap items-center justify-center gap-4 text-slate-400\">\n        <a href=\"index.html\" class=\"hover:text-white transition\">Pricing</a> • <a href=\"contact.html\" class=\"hover:text-white transition\">Contact</a> • <a href=\"use-a-consistent-modern-dark-theme-across-all.html\" class=\"hover:text-white transition\">Use A Consistent Modern Dark Theme Across All</a>\n      </div>\n      <p>&copy; 2026 an AI productivity Technologies Inc. All rights reserved.</p>\n    </div>\n  </footer>\n\n  <script>\n    lucide.createIcons();\n    const btn = document.getElementById('mobile-menu-btn');\n    const menu = document.getElementById('mobile-menu');\n    if (btn && menu) {\n      btn.addEventListener('click', () => menu.classList.toggle('hidden'));\n    }\n  </script>\n</body>\n</html>",
