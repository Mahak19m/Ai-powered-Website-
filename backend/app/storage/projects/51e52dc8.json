      "html_code": "<!DOCTYPE html>\n<html lang=\"en\" class=\"scroll-smooth dark\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>A Coffee Shop With Home | NexusAI</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <script src=\"https://unpkg.com/lucide@latest\"></script>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n  <script>\n    tailwind.config = {\n      darkMode: 'class',\n      theme: {\n        extend: {\n          fontFamily: {\n            sans: ['Plus Jakarta Sans', 'sans-serif'],\n            mono: ['JetBrains Mono', 'monospace'],\n          },\n          colors: {\n            brand: {\n              50: '#eef2ff',\n              500: '#6366f1',\n              600: '#4f46e5',\n              700: '#4338ca',\n            }\n          }\n        }\n      }\n    }\n  </script>\n</head>\n<body class=\"bg-slate-950 text-slate-100 font-sans antialiased selection:bg-indigo-500 selection:text-white\">\n\n  <!-- Header / Navigation -->\n  <header class=\"sticky top-0 z-50 backdrop-blur-md bg-slate-950/85 border-b border-slate-800/80\">\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between\">\n      <a href=\"index.html\" class=\"flex items-center gap-3 group\">\n        <div class=\"w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center text-white shadow-lg shadow-indigo-500/25 group-hover:scale-105 transition\">\n          <i data-lucide=\"sparkles\" class=\"w-5 h-5\"></i>\n        </div>\n        <span class=\"text-xl font-bold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-white via-slate-200 to-indigo-300\">NexusAI</span>\n      </a>\n\n      <!-- Desktop Nav Links -->\n      <nav class=\"hidden md:flex items-center gap-8 text-sm font-medium\">\n        <a href=\"index.html\" class=\"text-indigo-400 font-semibold transition-colors\">A Coffee Shop With Home</a>\n        <a href=\"about.html\" class=\"text-slate-400 hover:text-white transition-colors\">About</a>\n        <a href=\"menu.html\" class=\"text-slate-400 hover:text-white transition-colors\">Menu</a>\n        <a href=\"contact-sections.html\" class=\"text-slate-400 hover:text-white transition-colors\">Contact Sections</a>\n      </nav>\n\n      <div class=\"hidden md:flex items-center gap-4\">\n        <a href=\"contact-sections.html\" class=\"px-5 py-2.5 rounded-xl text-sm font-semibold bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white shadow-md shadow-indigo-500/20 transition-all flex items-center gap-2\">\n          <span>Get Started</span>\n          <i data-lucide=\"arrow-right\" class=\"w-4 h-4\"></i>\n        </a>\n      </div>\n\n      <!-- Mobile Hamburger Button -->\n      <button id=\"mobile-menu-btn\" class=\"md:hidden p-2 text-slate-400 hover:text-white rounded-lg border border-slate-800\">\n        <i data-lucide=\"menu\" class=\"w-5 h-5\"></i>\n      </button>\n    </div>\n\n    <!-- Mobile Drawer -->\n    <div id=\"mobile-menu\" class=\"hidden md:hidden px-6 py-4 bg-slate-900 border-b border-slate-800 space-y-2 text-sm\">\n      <a href=\"index.html\" class=\"block py-1.5 text-indigo-400 font-semibold\">A Coffee Shop With Home</a>\n      <a href=\"about.html\" class=\"block py-1.5 text-slate-300 hover:text-white\">About</a>\n      <a href=\"menu.html\" class=\"block py-1.5 text-slate-300 hover:text-white\">Menu</a>\n      <a href=\"contact-sections.html\" class=\"block py-1.5 text-slate-300 hover:text-white\">Contact Sections</a>\n      <div class=\"pt-2\">\n        <a href=\"contact-sections.html\" class=\"block text-center py-2 px-4 rounded-lg bg-indigo-600 text-white font-semibold text-xs\">Get Started</a>\n      </div>\n    </div>\n  </header>\n\n  <!-- A Coffee Shop With Home Page -->\n  <section class=\"py-24\">\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n      <div class=\"text-center max-w-3xl mx-auto mb-16\">\n        <h2 class=\"text-xs font-bold text-indigo-400 uppercase tracking-widest font-mono mb-3\">NexusAI Overview</h2>\n        <h1 class=\"text-4xl sm:text-5xl font-extrabold text-white tracking-tight\">A Coffee Shop With Home</h1>\n        <p class=\"text-slate-400 text-lg mt-4 leading-relaxed\">\n          Comprehensive details and resources for A Coffee Shop With Home.\n        </p>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto\">\n        <div class=\"p-8 rounded-2xl bg-slate-900 border border-slate-800\">\n          <div class=\"w-12 h-12 rounded-xl bg-indigo-950 border border-indigo-800/50 flex items-center justify-center text-indigo-400 mb-6\">\n            <i data-lucide=\"layers\" class=\"w-6 h-6\"></i>\n          </div>\n          <h4 class=\"text-xl font-bold text-white mb-3\">Structured Overview</h4>\n          <p class=\"text-slate-400 text-sm leading-relaxed\">\n            Essential specifications, structured metrics, and workflow integrations designed for A Coffee Shop With Home.\n          </p>\n        </div>\n\n        <div class=\"p-8 rounded-2xl bg-slate-900 border border-slate-800\">\n          <div class=\"w-12 h-12 rounded-xl bg-indigo-950 border border-indigo-800/50 flex items-center justify-center text-indigo-400 mb-6\">\n            <i data-lucide=\"zap\" class=\"w-6 h-6\"></i>\n          </div>\n          <h4 class=\"text-xl font-bold text-white mb-3\">Instant Execution</h4>\n          <p class=\"text-slate-400 text-sm leading-relaxed\">\n            Low-latency automated agent capabilities operating with continuous contextual memory.\n          </p>\n        </div>\n\n        <div class=\"p-8 rounded-2xl bg-slate-900 border border-slate-800\">\n          <div class=\"w-12 h-12 rounded-xl bg-indigo-950 border border-indigo-800/50 flex items-center justify-center text-indigo-400 mb-6\">\n            <i data-lucide=\"shield\" class=\"w-6 h-6\"></i>\n          </div>\n          <h4 class=\"text-xl font-bold text-white mb-3\">Enterprise Grade</h4>\n          <p class=\"text-slate-400 text-sm leading-relaxed\">\n            Fully sandboxed environment compliant with strict governance and security benchmarks.\n          </p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Footer -->\n  <footer class=\"border-t border-slate-900 bg-slate-950 py-12 text-center text-xs text-slate-500\">\n    <div class=\"max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-6\">\n      <div class=\"flex items-center gap-3 font-semibold text-slate-300\">\n        <div class=\"w-7 h-7 rounded-lg bg-indigo-600 flex items-center justify-center text-white\">\n          <i data-lucide=\"sparkles\" class=\"w-3.5 h-3.5\"></i>\n        </div>\n        <span>NexusAI Platform</span>\n      </div>\n      <div class=\"flex flex-wrap items-center justify-center gap-4 text-slate-400\">\n        <a href=\"index.html\" class=\"hover:text-white transition\">A Coffee Shop With Home</a> • <a href=\"about.html\" class=\"hover:text-white transition\">About</a> • <a href=\"menu.html\" class=\"hover:text-white transition\">Menu</a> • <a href=\"contact-sections.html\" class=\"hover:text-white transition\">Contact Sections</a>\n      </div>\n      <p>&copy; 2026 NexusAI Technologies Inc. All rights reserved.</p>\n    </div>\n  </footer>\n\n  <script>\n    lucide.createIcons();\n    const btn = document.getElementById('mobile-menu-btn');\n    const menu = document.getElementById('mobile-menu');\n    if (btn && menu) {\n      btn.addEventListener('click', () => menu.classList.toggle('hidden'));\n    }\n  </script>\n</body>\n</html>",
