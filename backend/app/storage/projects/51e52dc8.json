          "html": "<!DOCTYPE html>\n<html lang=\"en\" class=\"scroll-smooth dark\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>About | NexusAI</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <script src=\"https://unpkg.com/lucide@latest\"></script>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n  <script>\n    tailwind.config = {\n      darkMode: 'class',\n      theme: {\n        extend: {\n          fontFamily: {\n            sans: ['Plus Jakarta Sans', 'sans-serif'],\n            mono: ['JetBrains Mono', 'monospace'],\n          },\n          colors: {\n            brand: {\n              50: '#eef2ff',\n              500: '#6366f1',\n              600: '#4f46e5',\n              700: '#4338ca',\n            }\n          }\n        }\n      }\n    }\n  </script>\n</head>\n<body class=\"bg-slate-950 text-slate-100 font-sans antialiased selection:bg-indigo-500 selection:text-white\">\n\n  <!-- Header / Navigation -->\n  <header class=\"sticky top-0 z-50 backdrop-blur-md bg-slate-950/85 border-b border-slate-800/80\">\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between\">\n      <a href=\"index.html\" class=\"flex items-center gap-3 group\">\n        <div class=\"w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center text-white shadow-lg shadow-indigo-500/25 group-hover:scale-105 transition\">\n          <i data-lucide=\"sparkles\" class=\"w-5 h-5\"></i>\n        </div>\n        <span class=\"text-xl font-bold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-white via-slate-200 to-indigo-300\">NexusAI</span>\n      </a>\n\n      <!-- Desktop Nav Links -->\n      <nav class=\"hidden md:flex items-center gap-8 text-sm font-medium\">\n        <a href=\"index.html\" class=\"text-slate-400 hover:text-white transition-colors\">A Coffee Shop With Home</a>\n        <a href=\"about.html\" class=\"text-indigo-400 font-semibold transition-colors\">About</a>\n        <a href=\"menu.html\" class=\"text-slate-400 hover:text-white transition-colors\">Menu</a>\n        <a href=\"contact-sections.html\" class=\"text-slate-400 hover:text-white transition-colors\">Contact Sections</a>\n      </nav>\n\n      <div class=\"hidden md:flex items-center gap-4\">\n        <a href=\"contact-sections.html\" class=\"px-5 py-2.5 rounded-xl text-sm font-semibold bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white shadow-md shadow-indigo-500/20 transition-all flex items-center gap-2\">\n          <span>Get Started</span>\n          <i data-lucide=\"arrow-right\" class=\"w-4 h-4\"></i>\n        </a>\n      </div>\n\n      <!-- Mobile Hamburger Button -->\n      <button id=\"mobile-menu-btn\" class=\"md:hidden p-2 text-slate-400 hover:text-white rounded-lg border border-slate-800\">\n        <i data-lucide=\"menu\" class=\"w-5 h-5\"></i>\n      </button>\n    </div>\n\n    <!-- Mobile Drawer -->\n    <div id=\"mobile-menu\" class=\"hidden md:hidden px-6 py-4 bg-slate-900 border-b border-slate-800 space-y-2 text-sm\">\n      <a href=\"index.html\" class=\"block py-1.5 text-slate-300 hover:text-white\">A Coffee Shop With Home</a>\n      <a href=\"about.html\" class=\"block py-1.5 text-indigo-400 font-semibold\">About</a>\n      <a href=\"menu.html\" class=\"block py-1.5 text-slate-300 hover:text-white\">Menu</a>\n      <a href=\"contact-sections.html\" class=\"block py-1.5 text-slate-300 hover:text-white\">Contact Sections</a>\n      <div class=\"pt-2\">\n        <a href=\"contact-sections.html\" class=\"block text-center py-2 px-4 rounded-lg bg-indigo-600 text-white font-semibold text-xs\">Get Started</a>\n      </div>\n    </div>\n  </header>\n\n  <!-- About Page -->\n  <section class=\"py-24\">\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n      <div class=\"text-center max-w-3xl mx-auto mb-20\">\n        <h2 class=\"text-xs font-bold text-indigo-400 uppercase tracking-widest mb-3\">Our Mission</h2>\n        <h1 class=\"text-4xl sm:text-5xl font-extrabold text-white tracking-tight\">Reimagining Productivity for the AI Native Era</h1>\n        <p class=\"text-slate-400 text-lg mt-6 leading-relaxed\">\n          At NexusAI, we build autonomous software infrastructure that turns cognitive overhead into seamless execution. Our platform unifies context across your team's tools to deliver superhuman velocity.\n        </p>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8 mb-20\">\n        <div class=\"p-8 rounded-2xl bg-slate-900 border border-slate-800\">\n          <div class=\"w-12 h-12 rounded-xl bg-indigo-950 border border-indigo-800/50 flex items-center justify-center text-indigo-400 mb-6\">\n            <i data-lucide=\"target\" class=\"w-6 h-6\"></i>\n          </div>\n          <h4 class=\"text-xl font-bold text-white mb-3\">Autonomous Precision</h4>\n          <p class=\"text-slate-400 text-sm leading-relaxed\">\n            Multi-agent swarms equipped with fine-tuned reasoning models execute complex multi-step workflows without hallucinations or drift.\n          </p>\n        </div>\n\n        <div class=\"p-8 rounded-2xl bg-slate-900 border border-slate-800\">\n          <div class=\"w-12 h-12 rounded-xl bg-indigo-950 border border-indigo-800/50 flex items-center justify-center text-indigo-400 mb-6\">\n            <i data-lucide=\"network\" class=\"w-6 h-6\"></i>\n          </div>\n          <h4 class=\"text-xl font-bold text-white mb-3\">Unified Knowledge Mesh</h4>\n          <p class=\"text-slate-400 text-sm leading-relaxed\">\n            Connects Notion, Slack, GitHub, Google Workspace, and Jira into a real-time semantic vector graph with sub-millisecond retrieval.\n          </p>\n        </div>\n\n        <div class=\"p-8 rounded-2xl bg-slate-900 border border-slate-800\">\n          <div class=\"w-12 h-12 rounded-xl bg-indigo-950 border border-indigo-800/50 flex items-center justify-center text-indigo-400 mb-6\">\n            <i data-lucide=\"shield-check\" class=\"w-6 h-6\"></i>\n          </div>\n          <h4 class=\"text-xl font-bold text-white mb-3\">Zero-Trust Privacy</h4>\n          <p class=\"text-slate-400 text-sm leading-relaxed\">\n            Your proprietary company data is never used for training. End-to-end encryption with tenant isolation and granular access scopes.\n          </p>\n        </div>\n      </div>\n\n      <!-- Leadership / Team values -->\n      <div class=\"p-8 sm:p-12 rounded-3xl bg-slate-900/60 border border-slate-800 max-w-5xl mx-auto text-center\">\n        <h3 class=\"text-2xl font-bold text-white mb-4\">Built by Engineers &amp; AI Researchers</h3>\n        <p class=\"text-slate-400 text-sm max-w-2xl mx-auto mb-8 leading-relaxed\">\n          Our global distributed team previously built core infrastructure at top AI research labs and high-scale tech enterprises.\n        </p>\n        <div class=\"flex flex-wrap justify-center gap-4 text-xs font-mono text-indigo-400\">\n          <span class=\"px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800\">Distributed Swarms</span>\n          <span class=\"px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800\">Vector Embeddings</span>\n          <span class=\"px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800\">Real-Time Context</span>\n          <span class=\"px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800\">Enterprise Ready</span>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Footer -->\n  <footer class=\"border-t border-slate-900 bg-slate-950 py-12 text-center text-xs text