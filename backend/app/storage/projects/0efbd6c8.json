      "html_code": "<!DOCTYPE html>\n<html lang=\"en\" class=\"scroll-smooth dark\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>NexusAI - Next-Gen Autonomous AI Agents</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <script src=\"https://unpkg.com/lucide@latest\"></script>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n  <script>\n    tailwind.config = {\n      darkMode: 'class',\n      theme: {\n        extend: {\n          fontFamily: { sans: ['Plus Jakarta Sans', 'sans-serif'] },\n          colors: {\n            brand: {\n              50: '#eef2ff',\n              500: '#6366f1',\n              600: '#4f46e5',\n              700: '#4338ca',\n            }\n          }\n        }\n      }\n    }\n  </script>\n</head>\n<body class=\"bg-slate-950 text-slate-100 font-sans antialiased selection:bg-indigo-500 selection:text-white\">\n\n  <!-- Navigation -->\n  <header class=\"sticky top-0 z-50 backdrop-blur-md bg-slate-950/80 border-b border-slate-800/80\">\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between\">\n      <div class=\"flex items-center gap-3\">\n        <div class=\"w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center text-white shadow-lg shadow-indigo-500/25\">\n          <i data-lucide=\"sparkles\" class=\"w-5 h-5\"></i>\n        </div>\n        <span class=\"text-xl font-bold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-white via-slate-200 to-indigo-300\">NexusAI</span>\n      </div>\n\n      <nav class=\"hidden md:flex items-center gap-8 text-sm font-medium text-slate-400\">\n        <a href=\"#features\" class=\"hover:text-white transition-colors\">Features</a>\n        <a href=\"#demo\" class=\"hover:text-white transition-colors\">Live Demo</a>\n        <a href=\"#pricing\" class=\"hover:text-white transition-colors\">Pricing</a>\n        <a href=\"#faq\" class=\"hover:text-white transition-colors\">FAQ</a>\n      </nav>\n\n      <div class=\"hidden md:flex items-center gap-4\">\n        <a href=\"#pricing\" class=\"px-5 py-2.5 rounded-lg text-sm font-semibold bg-indigo-600 hover:bg-indigo-500 text-white shadow-md shadow-indigo-500/20 transition-all\">Get Started Free</a>\n      </div>\n    </div>\n  </header>\n\n  <!-- Hero Section -->\n  <section class=\"relative pt-24 pb-20 overflow-hidden text-center\">\n    <div class=\"max-w-5xl mx-auto px-4 sm:px-6 lg:px-8\">\n      <div class=\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-950/60 border border-indigo-500/30 text-indigo-400 text-xs font-semibold uppercase tracking-wider mb-8\">\n        <i data-lucide=\"zap\" class=\"w-3.5 h-3.5\"></i>\n        <span>Nexus Agentic Core v3.0 Released</span>\n      </div>\n\n      <h1 class=\"text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white mb-6 leading-tight\">\n        Build, Deploy &amp; Scale <br>\n        <span class=\"bg-clip-text text-transparent bg-gradient-to-r from-indigo-400 via-violet-300 to-cyan-300\">Autonomous AI Agents</span>\n      </h1>\n\n      <p class=\"text-lg sm:text-xl text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed\">\n        Empower your enterprise with intelligent multi-agent swarms that execute complex business workflows, analyze datasets, and write code automatically.\n      </p>\n\n      <div class=\"flex flex-col sm:flex-row items-center justify-center gap-4\">\n        <a href=\"#pricing\" class=\"w-full sm:w-auto px-8 py-4 rounded-xl font-semibold bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white shadow-xl shadow-indigo-600/25 flex items-center justify-center gap-2 transition\">\n          Start Free Sandbox\n          <i data-lucide=\"arrow-right\" class=\"w-4 h-4\"></i>\n        </a>\n      </div>\n    </div>\n  </section>\n\n  <!-- Features Grid -->\n  <section id=\"features\" class=\"py-24 bg-slate-900/50 border-t border-slate-900\">\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n      <div class=\"text-center max-w-3xl mx-auto mb-16\">\n        <h2 class=\"text-xs font-bold text-indigo-400 uppercase tracking-widest mb-3\">Engineered for Velocity</h2>\n        <h3 class=\"text-3xl sm:text-4xl font-bold text-white tracking-tight\">Everything you need to orchestrate agent fleets</h3>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n        <div class=\"p-8 rounded-2xl bg-slate-900 border border-slate-800\">\n          <div class=\"w-12 h-12 rounded-xl bg-indigo-950 border border-indigo-800/50 flex items-center justify-center text-indigo-400 mb-6\">\n            <i data-lucide=\"cpu\" class=\"w-6 h-6\"></i>\n          </div>\n          <h4 class=\"text-xl font-bold text-white mb-3\">Multi-Agent Swarms</h4>\n          <p class=\"text-slate-400 text-sm leading-relaxed\">Coordinate distributed agents with dynamic roles, hierarchical delegation, and shared memory vector stores.</p>\n        </div>\n\n        <div class=\"p-8 rounded-2xl bg-slate-900 border border-slate-800\">\n          <div class=\"w-12 h-12 rounded-xl bg-indigo-950 border border-indigo-800/50 flex items-center justify-center text-indigo-400 mb-6\">\n            <i data-lucide=\"shield-check\" class=\"w-6 h-6\"></i>\n          </div>\n          <h4 class=\"text-xl font-bold text-white mb-3\">Sandboxed Execution</h4>\n          <p class=\"text-slate-400 text-sm leading-relaxed\">Enterprise-grade isolation runs arbitrary code and tool actions safely with granular privilege scopes.</p>\n        </div>\n\n        <div class=\"p-8 rounded-2xl bg-slate-900 border border-slate-800\">\n          <div cla